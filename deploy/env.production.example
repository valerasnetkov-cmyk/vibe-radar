# Copy to /opt/viberadar/shared/.env.production and replace only placeholders.
# Keep this file outside the repository, owned by viberadar with mode 0600.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://viberadar:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/viberadar
DATABASE_SSL=disable

# Leave external side effects disabled for the first web + database boot.
GITHUB_TOKEN=
GITHUB_API_TIMEOUT_MS=10000
GITHUB_MAX_RETRIES=2
GITHUB_DISCOVERY_QUERIES=
GITHUB_DISCOVERY_INTERVAL_MS=3600000
GITHUB_DISCOVERY_MAX_QUERIES=1
SCORE_CALCULATION_INTERVAL_MS=3600000
CANDIDATE_SELECTION_INTERVAL_MS=3600000

TELEGRAM_EDITOR_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_EDITOR_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_API_TIMEOUT_MS=10000

WORKER_POLL_INTERVAL_MS=30000
WORKER_MAX_JOB_ATTEMPTS=3
WORKER_JOB_LEASE_MS=300000
PUBLICATION_INTERVAL_MS=3600000
DAILY_RADAR_INTERVAL_MS=86400000
WEEKLY_RADAR_INTERVAL_MS=604800000
AI_DAILY_MAX_CANDIDATES=0
AI_MAX_OUTPUT_CHARS=12000
AI_MAX_ATTEMPTS=2

OUTSCAN_INTEGRATION_ENABLED=false
OUTSCAN_NATIVE_CTA_ENABLED=false
OUTSCAN_CHECK_ENABLED=false
OUTSCAN_BASE_URL=https://outscan.ru
